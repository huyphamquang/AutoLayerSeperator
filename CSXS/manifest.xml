<ExtensionManifest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" ExtensionBundleId="com.pqh.autolayerseperator" ExtensionBundleName="AutoLayerSeperator" ExtensionBundleVersion="1.0.0" Version="6.0" allowExternalProcess="true">
	<ExtensionList>
		<Extension Id="com.pqh.autolayerseperator.extension" Version="1.0"/>
	</ExtensionList>
	<ExecutionEnvironment>
		<HostList>
			<Host Name="PHSP" Version="16.0"/>
            <Host Name="PHXS" Version="16.0"/>
		</HostList>
		<LocaleList>
			<Locale Code="All"/>
		</LocaleList>
		<RequiredRuntimeList>
			<RequiredRuntime Name="CSXS" Version="10.0"/>
		</RequiredRuntimeList>
		<CEFCommandLine>
			<Parameter>--enable-nodejs</Parameter>
		</CEFCommandLine>
	</ExecutionEnvironment>
	<DispatchInfoList>
		<Extension Id="com.pqh.autolayerseperator.extension">
			<DispatchInfo>
				<Resources>
					<MainPath>./index.html</MainPath>
					<ScriptPath>./host/hostscript.js</ScriptPath>
				</Resources>
				<Lifecycle>
					<AutoVisible>true</AutoVisible>
				</Lifecycle>
				<UI>
					<Type>Panel</Type>
					<Menu>Tách lớp-thuyết minh công trình</Menu>
					<Geometry>
						<Size>
                            <Height>250</Height>
                            <Width>300</Width>
                        </Size>
                        <MinSize>
                            <Height>210</Height>
                            <Width>250</Width>
                        </MinSize>
					</Geometry>
				</UI>
			</DispatchInfo>
		</Extension>
	</DispatchInfoList>
</ExtensionManifest>